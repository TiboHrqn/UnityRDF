@prefix ww: <http://unityRDF.org/ontology#> .
@prefix strips: <http://unityRDF.org/strips#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ww:unityRDFOntology a owl:Ontology ;
    rdfs:label "Unity RDF Ontology" .

strips:Action a owl:Class .
strips:Parameter a owl:Class .
strips:Fact a owl:Class .
strips:Argument a owl:Class .

strips:name a owl:DatatypeProperty .
strips:declaredOn a owl:ObjectProperty .
strips:parameter a owl:ObjectProperty .
strips:role a owl:DatatypeProperty .
strips:parameterType a owl:ObjectProperty .
strips:precondition a owl:ObjectProperty .
strips:addEffect a owl:ObjectProperty .
strips:deleteEffect a owl:ObjectProperty .
strips:predicate a owl:ObjectProperty .
strips:argument a owl:ObjectProperty .
strips:position a owl:DatatypeProperty .
strips:positive a owl:DatatypeProperty .

ww:Agent a owl:Class ;
    rdfs:label "Agent" .

ww:Bottle a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:Drinkable ;
    rdfs:subClassOf ww:Fillable ;
    rdfs:subClassOf ww:Pickable ;
    rdfs:label "Bottle" .

ww:Door a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:Openable ;
    rdfs:label "Door" .

ww:Key a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:Pickable ;
    rdfs:label "Key" .

ww:Room a owl:Class ;
    rdfs:label "Room" .

ww:SmartObject a owl:Class ;
    rdfs:label "SmartObject" .

ww:Drinkable a owl:Class ;
    rdfs:label "Drinkable" .

ww:Fillable a owl:Class ;
    rdfs:label "Fillable" .

ww:Openable a owl:Class ;
    rdfs:label "Openable" .

ww:Pickable a owl:Class ;
    rdfs:label "Pickable" .

ww:id a owl:DatatypeProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range xsd:string ;
    rdfs:label "id" .

ww:isFull a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ww:Drinkable ww:Fillable ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "isFull" .

ww:isOpen a owl:DatatypeProperty ;
    rdfs:domain ww:Openable ;
    rdfs:range xsd:boolean ;
    rdfs:label "isOpen" .

ww:isPickedUp a owl:DatatypeProperty ;
    rdfs:domain ww:Pickable ;
    rdfs:range xsd:boolean ;
    rdfs:label "isPickedUp" .

ww:locatedIn a owl:ObjectProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range ww:Room ;
    rdfs:label "locatedIn" .

ww:requiresKey a owl:ObjectProperty ;
    rdfs:domain ww:Openable ;
    rdfs:range ww:Key ;
    rdfs:label "requiresKey" .

_:action0 a strips:Action .
_:action0 strips:name "Drink" .
_:action0 strips:declaredOn ww:Drinkable .
_:action0 strips:parameter _:parameter1 .
_:parameter1 a strips:Parameter ;
    strips:role "actor" ;
    strips:position "0"^^xsd:integer ;
    strips:parameterType ww:Agent .
_:action0 strips:parameter _:parameter2 .
_:parameter2 a strips:Parameter ;
    strips:role "bottle" ;
    strips:position "1"^^xsd:integer ;
    strips:parameterType ww:Drinkable .
_:fact3 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:positive "true"^^xsd:boolean .
_:fact3 strips:argument _:argument4 .
_:argument4 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "bottle" .
_:action0 strips:precondition _:fact3 .
_:fact5 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:positive "true"^^xsd:boolean .
_:fact5 strips:argument _:argument6 .
_:argument6 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "bottle" .
_:action0 strips:deleteEffect _:fact5 .

_:action7 a strips:Action .
_:action7 strips:name "Drop" .
_:action7 strips:declaredOn ww:Pickable .
_:action7 strips:parameter _:parameter8 .
_:parameter8 a strips:Parameter ;
    strips:role "actor" ;
    strips:position "0"^^xsd:integer ;
    strips:parameterType ww:Agent .
_:action7 strips:parameter _:parameter9 .
_:parameter9 a strips:Parameter ;
    strips:role "item" ;
    strips:position "1"^^xsd:integer ;
    strips:parameterType ww:Pickable .
_:fact10 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:positive "true"^^xsd:boolean .
_:fact10 strips:argument _:argument11 .
_:argument11 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action7 strips:precondition _:fact10 .
_:fact12 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:positive "true"^^xsd:boolean .
_:fact12 strips:argument _:argument13 .
_:argument13 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action7 strips:deleteEffect _:fact12 .

_:action14 a strips:Action .
_:action14 strips:name "Fill" .
_:action14 strips:declaredOn ww:Fillable .
_:action14 strips:parameter _:parameter15 .
_:parameter15 a strips:Parameter ;
    strips:role "actor" ;
    strips:position "0"^^xsd:integer ;
    strips:parameterType ww:Agent .
_:action14 strips:parameter _:parameter16 .
_:parameter16 a strips:Parameter ;
    strips:role "container" ;
    strips:position "1"^^xsd:integer ;
    strips:parameterType ww:Fillable .
_:fact17 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:positive "false"^^xsd:boolean .
_:fact17 strips:argument _:argument18 .
_:argument18 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "container" .
_:action14 strips:precondition _:fact17 .
_:fact19 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:positive "true"^^xsd:boolean .
_:fact19 strips:argument _:argument20 .
_:argument20 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "container" .
_:action14 strips:addEffect _:fact19 .

_:action21 a strips:Action .
_:action21 strips:name "Open" .
_:action21 strips:declaredOn ww:Openable .
_:action21 strips:parameter _:parameter22 .
_:parameter22 a strips:Parameter ;
    strips:role "actor" ;
    strips:position "0"^^xsd:integer ;
    strips:parameterType ww:Agent .
_:action21 strips:parameter _:parameter23 .
_:parameter23 a strips:Parameter ;
    strips:role "door" ;
    strips:position "1"^^xsd:integer ;
    strips:parameterType ww:Openable .
_:action21 strips:parameter _:parameter24 .
_:parameter24 a strips:Parameter ;
    strips:role "key" ;
    strips:position "2"^^xsd:integer ;
    strips:parameterType ww:Key .
_:fact25 a strips:Fact ;
    strips:predicate ww:isOpen ;
    strips:positive "false"^^xsd:boolean .
_:fact25 strips:argument _:argument26 .
_:argument26 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "door" .
_:action21 strips:precondition _:fact25 .
_:fact27 a strips:Fact ;
    strips:predicate ww:requiresKey ;
    strips:positive "true"^^xsd:boolean .
_:fact27 strips:argument _:argument28 .
_:argument28 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "door" .
_:fact27 strips:argument _:argument29 .
_:argument29 a strips:Argument ;
    strips:position "1"^^xsd:integer ;
    strips:role "key" .
_:action21 strips:precondition _:fact27 .
_:fact30 a strips:Fact ;
    strips:predicate ww:hasInInventory ;
    strips:positive "true"^^xsd:boolean .
_:fact30 strips:argument _:argument31 .
_:argument31 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "actor" .
_:fact30 strips:argument _:argument32 .
_:argument32 a strips:Argument ;
    strips:position "1"^^xsd:integer ;
    strips:role "key" .
_:action21 strips:precondition _:fact30 .
_:fact33 a strips:Fact ;
    strips:predicate ww:isOpen ;
    strips:positive "true"^^xsd:boolean .
_:fact33 strips:argument _:argument34 .
_:argument34 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "door" .
_:action21 strips:addEffect _:fact33 .

_:action35 a strips:Action .
_:action35 strips:name "PickUp" .
_:action35 strips:declaredOn ww:Pickable .
_:action35 strips:parameter _:parameter36 .
_:parameter36 a strips:Parameter ;
    strips:role "actor" ;
    strips:position "0"^^xsd:integer ;
    strips:parameterType ww:Agent .
_:action35 strips:parameter _:parameter37 .
_:parameter37 a strips:Parameter ;
    strips:role "item" ;
    strips:position "1"^^xsd:integer ;
    strips:parameterType ww:Pickable .
_:fact38 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:positive "false"^^xsd:boolean .
_:fact38 strips:argument _:argument39 .
_:argument39 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action35 strips:precondition _:fact38 .
_:fact40 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:positive "true"^^xsd:boolean .
_:fact40 strips:argument _:argument41 .
_:argument41 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action35 strips:addEffect _:fact40 .

