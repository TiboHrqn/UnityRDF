_:action14 strips:declaredOn ww:IPickable .
_:action14 strips:parameter _:parameter15 .
_:parameter15 a strips:Parameter .
_:parameter15 strips:role "actor" .
_:parameter15 strips:parameterType ww:Agent .
_:action14 strips:parameter _:parameter16 .
_:parameter16 a strips:Parameter .
_:parameter16 strips:role "item" .
_:parameter16 strips:parameterType ww:IPickable .
_:fact17 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:hasArguments true .
_:fact17 strips:argument _:argument18 .
_:argument18 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action14 strips:precondition _:fact17 .
_:fact17 strips:positive "false"^^xsd:boolean .
_:fact19 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:hasArguments true .
_:fact19 strips:argument _:argument20 .
_:argument20 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action14 strips:addEffect _:fact19 .

_:action21 a strips:Action .
