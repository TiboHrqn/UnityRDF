_:action21 strips:declaredOn ww:IPickable .
_:action21 strips:parameter _:parameter22 .
_:parameter22 a strips:Parameter .
_:parameter22 strips:role "actor" .
_:parameter22 strips:parameterType ww:Agent .
_:action21 strips:parameter _:parameter23 .
_:parameter23 a strips:Parameter .
_:parameter23 strips:role "item" .
_:parameter23 strips:parameterType ww:IPickable .
_:fact24 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:hasArguments true .
_:fact24 strips:argument _:argument25 .
_:argument25 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action21 strips:precondition _:fact24 .
_:fact24 strips:positive "true"^^xsd:boolean .
_:fact26 a strips:Fact ;
    strips:predicate ww:isPickedUp ;
    strips:hasArguments true .
_:fact26 strips:argument _:argument27 .
_:argument27 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "item" .
_:action21 strips:deleteEffect _:fact26 .

_:action28 a strips:Action .
_:action28 strips:name "Open" .
_:action28 strips:declaredOn ww:IOpenable .
_:action28 strips:parameter _:parameter29 .
_:parameter29 a strips:Parameter .
_:parameter29 strips:role "actor" .
_:parameter29 strips:parameterType ww:Agent .
_:action28 strips:parameter _:parameter30 .
_:parameter30 a strips:Parameter .
_:parameter30 strips:role "door" .
_:parameter30 strips:parameterType ww:IOpenable .
_:action28 strips:parameter _:parameter31 .
_:parameter31 a strips:Parameter .
_:parameter31 strips:role "key" .
_:parameter31 strips:parameterType ww:Key .
_:fact32 a strips:Fact ;
