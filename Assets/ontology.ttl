_:fact37 strips:argument _:argument38 .
_:argument38 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "actor" .
_:fact37 strips:argument _:argument39 .
_:argument39 a strips:Argument ;
    strips:position "1"^^xsd:integer ;
    strips:role "key" .
_:action28 strips:precondition _:fact37 .
_:fact37 strips:positive "true"^^xsd:boolean .
_:fact40 a strips:Fact ;
    strips:predicate ww:isOpen ;
    strips:hasArguments true .
_:fact40 strips:argument _:argument41 .
_:argument41 a strips:Argument ;
