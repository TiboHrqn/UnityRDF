_:action7 strips:declaredOn ww:IFillable .
_:action7 strips:parameter _:parameter8 .
_:parameter8 a strips:Parameter .
_:parameter8 strips:role "actor" .
_:parameter8 strips:parameterType ww:Agent .
_:action7 strips:parameter _:parameter9 .
_:parameter9 a strips:Parameter .
_:parameter9 strips:role "container" .
_:parameter9 strips:parameterType ww:IFillable .
_:fact10 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:hasArguments true .
_:fact10 strips:argument _:argument11 .
_:argument11 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "container" .
_:action7 strips:precondition _:fact10 .
_:fact10 strips:positive "false"^^xsd:boolean .
_:fact12 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:hasArguments true .
_:fact12 strips:argument _:argument13 .
_:argument13 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "container" .
_:action7 strips:addEffect _:fact12 .

