@prefix ww: <http://unityRDF.org/ontology#> .
@prefix strips: <http://unityRDF.org/strips#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ww:unityRDFOntology a owl:Ontology ;
    rdfs:label "Unity RDF Ontology" .

strips:Action a owl:Class .
strips:Parameter a owl:Class .
strips:Fact a owl:Class .
strips:Argument a owl:Class .

strips:name a owl:DatatypeProperty ;
    rdfs:range xsd:string .
strips:declaredOn a owl:ObjectProperty ;
    rdfs:domain strips:Action ;
    rdfs:range owl:Class .
strips:parameter a owl:ObjectProperty ;
    rdfs:domain strips:Action ;
    rdfs:range strips:Parameter .
strips:role a owl:DatatypeProperty ;
    rdfs:range xsd:string .
strips:parameterType a owl:ObjectProperty ;
    rdfs:domain strips:Parameter ;
    rdfs:range owl:Class .
strips:position a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
strips:methodPosition a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
strips:isTarget a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .
strips:precondition a owl:ObjectProperty ;
    rdfs:domain strips:Action ;
    rdfs:range strips:Fact .
strips:addEffect a owl:ObjectProperty ;
    rdfs:domain strips:Action ;
    rdfs:range strips:Fact .
strips:deleteEffect a owl:ObjectProperty ;
    rdfs:domain strips:Action ;
    rdfs:range strips:Fact .
strips:predicate a owl:ObjectProperty ;
    rdfs:domain strips:Fact ;
    rdfs:range rdf:Property .
strips:argument a owl:ObjectProperty ;
    rdfs:domain strips:Fact ;
    rdfs:range strips:Argument .
strips:positive a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ww:Agent a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:MoveableTo ;
    rdfs:label "Agent" .

ww:Bottle a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:Drinkable ;
    rdfs:subClassOf ww:Fillable ;
    rdfs:subClassOf ww:MoveableTo ;
    rdfs:subClassOf ww:Pickable ;
    rdfs:label "Bottle" .

ww:Door a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:MoveableTo ;
    rdfs:subClassOf ww:Openable ;
    rdfs:label "Door" .

ww:Key a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:subClassOf ww:MoveableTo ;
    rdfs:subClassOf ww:Pickable ;
    rdfs:label "Key" .

ww:Room a owl:Class ;
    rdfs:label "Room" .

ww:SmartObject a owl:Class ;
    rdfs:subClassOf ww:MoveableTo ;
    rdfs:label "SmartObject" .

ww:Drinkable a owl:Class ;
    rdfs:label "Drinkable" .

ww:Fillable a owl:Class ;
    rdfs:label "Fillable" .

ww:MoveableTo a owl:Class ;
    rdfs:label "MoveableTo" .

ww:Openable a owl:Class ;
    rdfs:label "Openable" .

ww:Pickable a owl:Class ;
    rdfs:label "Pickable" .

ww:canMove a owl:DatatypeProperty ;
    rdfs:domain ww:Agent ;
    rdfs:range xsd:boolean ;
    rdfs:label "canMove" .

ww:id a owl:DatatypeProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range xsd:string ;
    rdfs:label "id" .

ww:isFull a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ww:Drinkable ww:Fillable ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "isFull" .

ww:isLocked a owl:DatatypeProperty ;
    rdfs:domain ww:Openable ;
    rdfs:range xsd:boolean ;
    rdfs:label "isLocked" .

ww:isOpen a owl:DatatypeProperty ;
    rdfs:domain ww:Openable ;
    rdfs:range xsd:boolean ;
    rdfs:label "isOpen" .

ww:canReach a owl:ObjectProperty ;
    rdfs:domain ww:Agent ;
    rdfs:range ww:SmartObject ;
    rdfs:label "canReach" .

ww:hasInInventory a owl:ObjectProperty ;
    rdfs:domain ww:Agent ;
    rdfs:range ww:SmartObject ;
    rdfs:label "hasInInventory" .

ww:isNear a owl:ObjectProperty ;
    rdfs:domain ww:Agent ;
    rdfs:range ww:SmartObject ;
    rdfs:label "isNear" .

ww:locatedIn a owl:ObjectProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range ww:Room ;
    rdfs:label "locatedIn" .

ww:requiresKey a owl:ObjectProperty ;
    rdfs:domain ww:Openable ;
    rdfs:range ww:Key ;
    rdfs:label "requiresKey" .

