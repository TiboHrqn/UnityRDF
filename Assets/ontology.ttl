@prefix ww: <http://unityRDF.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix strips: <http://unityRDF.org/strips#> .

ww:unityRDFOntology a owl:Ontology .

ww:Agent a owl:Class ;
    rdfs:label "Agent" .

ww:Bottle a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:label "Bottle" .

ww:Door a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:label "Door" .

ww:Key a owl:Class ;
    rdfs:subClassOf ww:SmartObject ;
    rdfs:label "Key" .

ww:Room a owl:Class ;
    rdfs:label "Room" .

ww:SmartObject a owl:Class ;
    rdfs:label "SmartObject" .

ww:isPickedUp a owl:DatatypeProperty ;
    rdfs:domain ww:Bottle ;
    rdfs:range xsd:boolean ;
    rdfs:label "isPickedUp" .

ww:isFull a owl:DatatypeProperty ;
    rdfs:domain ww:Bottle ;
    rdfs:range xsd:boolean ;
    rdfs:label "isFull" .

ww:id a owl:DatatypeProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range xsd:string ;
    rdfs:label "id" .

ww:isOpen a owl:DatatypeProperty ;
    rdfs:domain ww:Door ;
    rdfs:range xsd:boolean ;
    rdfs:label "isOpen" .

ww:isPickedUp a owl:DatatypeProperty ;
    rdfs:domain ww:Key ;
    rdfs:range xsd:boolean ;
    rdfs:label "isPickedUp" .

ww:locatedIn a owl:ObjectProperty ;
    rdfs:domain ww:SmartObject ;
    rdfs:range ww:Room ;
    rdfs:label "locatedIn" .

ww:requiresKey a owl:ObjectProperty ;
    rdfs:domain ww:Door ;
    rdfs:range ww:Key ;
    rdfs:label "requiresKey" .

_:action0 a strips:Action .
_:action0 strips:name "Drink" .
_:action0 strips:declaredOn ww:IDrinkable .
_:action0 strips:parameter _:parameter1 .
_:parameter1 a strips:Parameter .
_:parameter1 strips:role "actor" .
_:parameter1 strips:parameterType ww:Agent .
_:action0 strips:parameter _:parameter2 .
_:parameter2 a strips:Parameter .
_:parameter2 strips:role "bottle" .
_:parameter2 strips:parameterType ww:IDrinkable .
_:fact3 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:hasArguments true .
_:fact3 strips:argument _:argument4 .
_:argument4 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "bottle" .
_:action0 strips:precondition _:fact3 .
_:fact3 strips:positive "true"^^xsd:boolean .
_:fact5 a strips:Fact ;
    strips:predicate ww:isFull ;
    strips:hasArguments true .
_:fact5 strips:argument _:argument6 .
_:argument6 a strips:Argument ;
    strips:position "0"^^xsd:integer ;
    strips:role "bottle" .
_:action0 strips:deleteEffect _:fact5 .

